{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntentClassificationResult",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "EMERGENCIA",
        "EXPENSAS_DATOS_PAGO",
        "EXPENSAS_COMPROBANTE",
        "EXPENSAS_RECLAMO_SALDO",
        "RECLAMO_MANTENIMIENTO",
        "MUDANZA_Y_REGLAMENTO",
        "CONTACTO_PORTERIA",
        "CONSULTA_ADMINISTRACION",
        "SALUDO_CORDIAL",
        "DESCONOCIDO_AMBIGUO"
      ]
    },
    "sub_intent": {
      "type": "string"
    },
    "urgency": {
      "type": "string",
      "enum": ["EMERGENCY", "HIGH", "NORMAL", "LOW"]
    },
    "extracted_entities": {
      "type": "object",
      "properties": {
        "consorcio_mencionado": {
          "type": ["string", "null"]
        },
        "unidad_funcional": {
          "type": ["string", "null"]
        },
        "descripcion_corta": {
          "type": ["string", "null"]
        }
      },
      "required": ["consorcio_mencionado", "unidad_funcional", "descripcion_corta"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "intent",
    "sub_intent",
    "urgency",
    "extracted_entities",
    "confidence"
  ],
  "additionalProperties": false
}
