# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO — CHATBOT CONSORCIO (DRA. IVANA SELIZ)
# ==============================================================================

# --- Entorno de Ejecución ---
ENV=development                 # development | production
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Base de Datos Central (PostgreSQL con pgvector) ---
POSTGRES_USER=consorcio_admin
POSTGRES_PASSWORD=Secr3tP@ssw0rd
POSTGRES_DB=consorcio_db
DATABASE_URL=postgresql+asyncpg://consorcio_admin:Secr3tP@ssw0rd@postgres:5432/consorcio_db

# --- Cache y Buffer (Redis) ---
REDIS_URL=redis://redis:6379/0

# --- Pasarela WhatsApp (Evolution API v2) ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=consorcio_api_token_secret
EVOLUTION_INSTANCE_NAME=ivana_seliz_whatsapp

# --- Intermediario Conversacional (Chatwoot API) ---
CHATWOOT_API_URL=http://chatwoot:3000
CHATWOOT_API_ACCESS_TOKEN=chatwoot_bot_or_admin_token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# --- Panel de Backoffice (NocoDB) ---
NOCODB_API_URL=http://nocodb:8080
NOCODB_API_TOKEN=nocodb_jwt_or_api_token_here


# --- Horarios de Atención Humana (Silencio Total del Bot) ---
OFFICE_HOURS_MF_START=10:00
OFFICE_HOURS_MF_END=18:00
OFFICE_HOURS_SAT_START=10:00
OFFICE_HOURS_SAT_END=13:00

# --- Franja de Silencio Nocturno (Quiet Hours) ---
QUIET_HOURS_START=00:00
QUIET_HOURS_END=07:30

# --- Buffer y Debounce de Ráfagas (Producción) ---
DEBOUNCE_SECONDS=12
DEBOUNCE_JITTER_SECONDS=3

# ==============================================================================
# MODO DE DEBUG RÁPIDO & BYPASS DE TIEMPOS DE ESPERA (TESTING ÁGIL)
# ==============================================================================
FAST_DEBUG_MODE=true             # Master switch: activa respuesta inmediata sin demoras
BYPASS_DEBOUNCE_BUFFER=true      # true = saltea los 12s del buffer y procesa en 0s
DISABLE_RANDOM_JITTER=true       # true = elimina pausas aleatorias de escritura humana
OVERRIDE_SCHEDULE_OFF_HOURS=true # true = simula que siempre está fuera de horario (testeo 24/7)

# --- Modelos Locales en CPU (LXC Proxmox) ---
WHISPER_MODEL=small              # small
WHISPER_COMPUTE_TYPE=int8        # int8 (optimizado para CPU)
WHISPER_THREADS=6                # 6 núcleos dedicados
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
RAG_SIMILARITY_THRESHOLD=0.85
TEV1_MODEL_PATH=/app/models/tev1-0.8b-q4_k_m.gguf
LLM_DRAFT_MODEL_PATH=/app/models/qwen2.5-3b-instruct-q4_k_m.gguf

# ==============================================================================
# OBSERVABILIDAD, MÉTRICAS DE LATENCIA Y TRAZABILIDAD DE LOGS (TESTING)
# ==============================================================================
ENABLE_PIPELINE_LOGS=true        # true para activar logs paso a paso de cada nodo
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=CONSOLE               # CONSOLE (legible con colores y tags) | JSON (estructurado)
LOG_LATENCY_METRICS=true         # true para medir y registrar latencias por nodo (ms)
